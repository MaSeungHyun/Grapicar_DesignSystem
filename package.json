    "storybook": "pnpm --filter storybook dev",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}

