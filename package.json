{
  "name": "design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "pnpm --filter storybook dev",
    "build": "pnpm -r build",
    "build:ui": "pnpm --filter @grapicar-studio/design-system build",
