{
  "name": "design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @grapicar-studio/design-system dev\" \"pnpm --filter storybook dev\"",
    "dev:ui": "pnpm --filter @grapicar-studio/design-system dev",
    "dev:storybook": "pnpm --filter storybook dev",
    "build": "pnpm -r build",
    "build:ui": "pnpm --filter @grapicar-studio/design-system build",
    "build:storybook": "pnpm --filter storybook build",
    "storybook": "pnpm --filter storybook dev",
    "type-check": "pnpm -r type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "baseline-browser-mapping": "^2.10.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}

